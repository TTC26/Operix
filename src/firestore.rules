service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "mode", "summary", "dataJson", "updatedAt"])
        && request.resource.data.dataJson is string
        && request.resource.data.dataJson.size() < 900000;
    }
    match /users/{uid}/unlocks/{projectId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
